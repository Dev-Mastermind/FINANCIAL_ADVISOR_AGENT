# Financial Advisor Agent - Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# DEVELOPMENT ENVIRONMENT
# =============================================================================
# For development, you can leave these as mock values or use real API keys
# The application will automatically use mock services if keys are missing

# Database Configuration
DATABASE_URL=ecto://postgres:postgres@localhost/financial_advisor_agent_dev

# OpenAI Configuration (Optional for development - will use mocks if not set)
OPENAI_API_KEY=your-openai-api-key-here

# Google OAuth Configuration (Optional for development - will use mocks if not set)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# HubSpot Configuration (Optional for development - will use mocks if not set)
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:4000/hubspot/callback

# Secret Keys (Optional for development - will use mock values if not set)
SECRET_KEY_BASE=your-secret-key-base-here
GUARDIAN_SECRET_KEY=your-guardian-secret-key-here

# =============================================================================
# STAGING/PRODUCTION ENVIRONMENT
# =============================================================================
# These are REQUIRED for staging and production environments
# Uncomment and set these when deploying to staging/production

# Database (Required for staging/production)
# DATABASE_URL=postgresql://user:password@host:port/database

# OpenAI (Required for staging/production)
# OPENAI_API_KEY=sk-proj-your-real-openai-key

# Google OAuth (Required for staging/production)
# GOOGLE_CLIENT_ID=your-real-google-client-id
# GOOGLE_CLIENT_SECRET=your-real-google-client-secret

# HubSpot (Required for staging/production)
# HUBSPOT_CLIENT_ID=your-real-hubspot-client-id
# HUBSPOT_CLIENT_SECRET=your-real-hubspot-client-secret
# HUBSPOT_REDIRECT_URI=https://your-domain.com/hubspot/callback

# Secret Keys (Required for staging/production)
# SECRET_KEY_BASE=your-real-secret-key-base
# GUARDIAN_SECRET_KEY=your-real-guardian-secret-key

# Phoenix Configuration (Required for staging/production)
# PHX_HOST=your-domain.com
# PORT=4000
# MIX_ENV=prod

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 
# 1. For local development, you can run the app without any real API keys
#    - Mock services will be used automatically
#    - All integrations will work with fake data
#    - No external API calls will be made
#
# 2. To test with real services in development:
#    - Set the appropriate API keys above
#    - The app will use real services instead of mocks
#
# 3. For staging/production:
#    - All API keys are REQUIRED
#    - Mock services are disabled
#    - Real external API calls will be made
#
# =============================================================================
