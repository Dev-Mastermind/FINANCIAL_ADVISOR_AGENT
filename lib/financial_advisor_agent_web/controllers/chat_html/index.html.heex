<div class="flex h-screen bg-gray-100">
  <!-- Sidebar -->
  <div class="w-64 bg-white shadow-lg">
    <div class="p-4">
      <h2 class="text-xl font-bold text-gray-800">Financial Advisor Agent</h2>
    </div>
    
    <!-- Navigation -->
    <nav class="mt-4">
      <a href="/dashboard" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
        Dashboard
      </a>
      <a href="/chat" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 bg-gray-100">
        Chat
      </a>
      <a href="/integrations" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
        Integrations
      </a>
    </nav>
    
    <!-- Recent Tasks -->
    <div class="mt-8 px-4">
      <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide">Recent Tasks</h3>
      <div class="mt-2 space-y-2">
        <%= for task <- @tasks do %>
          <div class="p-2 bg-gray-50 rounded text-sm">
            <div class="font-medium text-gray-800"><%= task.title %></div>
            <div class="text-gray-600 text-xs"><%= task.status %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <!-- Main Chat Area -->
  <div class="flex-1 flex flex-col">
    <!-- Chat Header -->
    <div class="bg-white shadow-sm border-b px-6 py-4">
      <h1 class="text-2xl font-bold text-gray-800">AI Financial Advisor</h1>
      <p class="text-gray-600">Ask me anything about your clients, schedule appointments, or manage your CRM</p>
    </div>
    
    <!-- Chat Messages -->
    <div id="chat-messages" class="flex-1 overflow-y-auto p-6 space-y-4">
      <!-- Welcome Message -->
      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
            <span class="text-white text-sm font-medium">AI</span>
          </div>
        </div>
        <div class="flex-1">
          <div class="bg-gray-100 rounded-lg p-4">
            <p class="text-gray-800">
              Hello! I'm your AI financial advisor assistant. I can help you with:
            </p>
            <ul class="mt-2 text-sm text-gray-600 list-disc list-inside">
              <li>Answering questions about your clients using email and CRM data</li>
              <li>Scheduling appointments and sending emails</li>
              <li>Managing your HubSpot contacts</li>
              <li>Searching through your emails and calendar</li>
            </ul>
            <p class="mt-2 text-sm text-gray-600">
              What would you like me to help you with today?
            </p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Chat Input -->
    <div class="bg-white border-t px-6 py-4">
      <form id="chat-form" class="flex space-x-4">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <div class="flex-1">
          <input 
            type="text" 
            id="message-input" 
            placeholder="Type your message here..." 
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-900 placeholder-gray-500"
            required
          />
        </div>
        <button 
          type="submit" 
          class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Chat functionality
  const chatForm = document.getElementById('chat-form');
  const messageInput = document.getElementById('message-input');
  const chatMessages = document.getElementById('chat-messages');
  
  let conversationId = Date.now().toString();
  
  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const message = messageInput.value.trim();
    if (!message) return;
    
    // Add user message to chat
    addMessageToChat(message, 'user');
    messageInput.value = '';
    
    // Get CSRF token from the form
    const csrfToken = document.querySelector('input[name="_csrf_token"]').value;
    
    // Send message to server
    try {
      const response = await fetch('/chat/message', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
          message: message,
          conversation_id: conversationId
        })
      });
      
      const data = await response.json();
      
      if (data.success) {
        // Poll for task completion
        pollTaskStatus(data.task_id);
      } else {
        addMessageToChat('Sorry, there was an error processing your message.', 'ai');
      }
    } catch (error) {
      console.error('Error:', error);
      addMessageToChat('Sorry, there was an error processing your message.', 'ai');
    }
  });
  
  function addMessageToChat(message, sender) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'flex items-start space-x-3';
    
    if (sender === 'user') {
      messageDiv.innerHTML = `
        <div class="flex-1">
          <div class="bg-blue-500 text-white rounded-lg p-4 ml-12">
            <p>${message}</p>
          </div>
        </div>
      `;
    } else {
      messageDiv.innerHTML = `
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
            <span class="text-white text-sm font-medium">AI</span>
          </div>
        </div>
        <div class="flex-1">
          <div class="bg-gray-100 rounded-lg p-4">
            <p class="text-gray-800">${message}</p>
          </div>
        </div>
      `;
    }
    
    chatMessages.appendChild(messageDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
  
  function pollTaskStatus(taskId) {
    const pollInterval = setInterval(async () => {
      try {
        const response = await fetch(`/chat/task/${taskId}`);
        const data = await response.json();
        
        if (data.success) {
          const task = data.task;
          
          if (task.status === 'completed') {
            clearInterval(pollInterval);
            addMessageToChat(task.output_data.response || 'Task completed successfully.', 'ai');
          } else if (task.status === 'failed') {
            clearInterval(pollInterval);
            addMessageToChat('Sorry, there was an error: ' + (task.error_message || 'Unknown error'), 'ai');
          }
        }
      } catch (error) {
        console.error('Error polling task status:', error);
        clearInterval(pollInterval);
        addMessageToChat('Sorry, there was an error checking task status.', 'ai');
      }
    }, 1000);
  }
</script>
