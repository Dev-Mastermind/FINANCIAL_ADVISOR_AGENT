#!/bin/bash

# Environment Setup Script for Financial Advisor Agent
# Copy this file to setup_env.sh and replace with your actual values

# Database Configuration
export DATABASE_URL="ecto://postgres:postgres@localhost:5432/financial_advisor_agent_dev"

# OpenAI Configuration
export OPENAI_API_KEY="your-openai-api-key-here"

# Google OAuth Configuration
export GOOGLE_CLIENT_ID="your-google-client-id-here"
export GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# HubSpot Configuration
export HUBSPOT_API_KEY="your-hubspot-api-key-here"
export HUBSPOT_CLIENT_ID="your-hubspot-client-id-here"
export HUBSPOT_CLIENT_SECRET="your-hubspot-client-secret-here"

# Security Configuration
export SECRET_KEY_BASE="your-secret-key-base-here"
export GUARDIAN_SECRET_KEY="your-guardian-secret-key-here"

echo "Environment variables set for Financial Advisor Agent"
