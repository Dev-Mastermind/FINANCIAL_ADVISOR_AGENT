# Docker Environment Variables for Financial Advisor Agent
# Copy this file to docker.env and replace with your actual values

# Database Configuration
DATABASE_URL=ecto://postgres:postgres@postgres:5432/financial_advisor_agent_prod

# Application Secrets (replace with strong, unique values for production)
SECRET_KEY_BASE=your-secret-key-base-here-replace-with-real-secret
GUARDIAN_SECRET_KEY=your-guardian-secret-key-here

# OpenAI API Key (replace with your actual key)
OPENAI_API_KEY=your-openai-api-key-here

# Google OAuth Credentials (replace with your actual credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# HubSpot API Key (replace with your actual key)
HUBSPOT_API_KEY=your-hubspot-api-key-here
HUBSPOT_CLIENT_ID=your-hubspot-client-id-here
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret-here
HUBSPOT_REDIRECT_URI=http://localhost:4000/hubspot/callback

# Other application settings
PORT=4000
MIX_ENV=prod
